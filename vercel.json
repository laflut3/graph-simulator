{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/en-us", "destination": "/en-us/", "permanent": true },
    { "source": "/fr-fr", "destination": "/fr-fr/", "permanent": true },
    { "source": "/simulator", "destination": "/en-us/simulator", "permanent": true },
    { "source": "/docs", "destination": "/en-us/docs", "permanent": true },
    { "source": "/legal", "destination": "/en-us/legal", "permanent": true }
  ]
}
